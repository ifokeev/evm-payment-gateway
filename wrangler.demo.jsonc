{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evm-payment-gateway-showcase",
  "main": "demo/worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./demo/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "services": [
    {
      "binding": "GATEWAY",
      "service": "evm-payment-gateway-api"
    }
  ],
  "kv_namespaces": [{ "binding": "DEMO_EVENTS" }],
  "ratelimits": [
    {
      "name": "DEMO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "DEMO_OPTIONS_JSON": "[{\"chain\":\"base-sepolia\",\"chainLabel\":\"Base Sepolia\",\"chainId\":84532,\"asset\":\"USDC\",\"decimals\":6,\"minimumAmount\":\"0.01\",\"maximumAmount\":\"5\",\"defaultAmount\":\"0.50\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://sepolia.base.org\",\"explorerUrl\":\"https://sepolia.basescan.org\"},{\"chain\":\"base-sepolia\",\"chainLabel\":\"Base Sepolia\",\"chainId\":84532,\"asset\":\"ETH\",\"decimals\":18,\"minimumAmount\":\"0.000001\",\"maximumAmount\":\"0.001\",\"defaultAmount\":\"0.00001\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://sepolia.base.org\",\"explorerUrl\":\"https://sepolia.basescan.org\"},{\"chain\":\"ethereum-sepolia\",\"chainLabel\":\"Ethereum Sepolia\",\"chainId\":11155111,\"asset\":\"USDC\",\"decimals\":6,\"minimumAmount\":\"0.01\",\"maximumAmount\":\"5\",\"defaultAmount\":\"0.50\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://ethereum-sepolia-rpc.publicnode.com\",\"explorerUrl\":\"https://sepolia.etherscan.io\"},{\"chain\":\"ethereum-sepolia\",\"chainLabel\":\"Ethereum Sepolia\",\"chainId\":11155111,\"asset\":\"ETH\",\"decimals\":18,\"minimumAmount\":\"0.000001\",\"maximumAmount\":\"0.001\",\"defaultAmount\":\"0.00001\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://ethereum-sepolia-rpc.publicnode.com\",\"explorerUrl\":\"https://sepolia.etherscan.io\"},{\"chain\":\"bnb-testnet\",\"chainLabel\":\"BNB Testnet\",\"chainId\":97,\"asset\":\"TBNB\",\"decimals\":18,\"minimumAmount\":\"0.00001\",\"maximumAmount\":\"0.01\",\"defaultAmount\":\"0.001\",\"nativeAsset\":\"TBNB\",\"walletRpcUrl\":\"https://bsc-testnet-dataseed.bnbchain.org\",\"explorerUrl\":\"https://testnet.bscscan.com\"}]",
    "DEMO_EXPIRY_SECONDS": "1800"
  },
  "env": {
    "testnet": {
      "secrets": {
        "required": [
          "PAYMENT_API_KEY",
          "PAYMENT_WEBHOOK_SECRET",
          "DEMO_SESSION_SECRET",
          "TURNSTILE_SITE_KEY",
          "TURNSTILE_SECRET_KEY"
        ]
      },
      "services": [
        {
          "binding": "GATEWAY",
          "service": "evm-payment-gateway-api-testnet"
        }
      ],
      "kv_namespaces": [{ "binding": "DEMO_EVENTS" }],
      "ratelimits": [
        {
          "name": "DEMO_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 3, "period": 60 }
        }
      ],
      "vars": {
        "DEMO_OPTIONS_JSON": "[{\"chain\":\"base-sepolia\",\"chainLabel\":\"Base Sepolia\",\"chainId\":84532,\"asset\":\"USDC\",\"decimals\":6,\"minimumAmount\":\"0.01\",\"maximumAmount\":\"5\",\"defaultAmount\":\"0.50\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://sepolia.base.org\",\"explorerUrl\":\"https://sepolia.basescan.org\"},{\"chain\":\"base-sepolia\",\"chainLabel\":\"Base Sepolia\",\"chainId\":84532,\"asset\":\"ETH\",\"decimals\":18,\"minimumAmount\":\"0.000001\",\"maximumAmount\":\"0.001\",\"defaultAmount\":\"0.00001\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://sepolia.base.org\",\"explorerUrl\":\"https://sepolia.basescan.org\"},{\"chain\":\"ethereum-sepolia\",\"chainLabel\":\"Ethereum Sepolia\",\"chainId\":11155111,\"asset\":\"USDC\",\"decimals\":6,\"minimumAmount\":\"0.01\",\"maximumAmount\":\"5\",\"defaultAmount\":\"0.50\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://ethereum-sepolia-rpc.publicnode.com\",\"explorerUrl\":\"https://sepolia.etherscan.io\"},{\"chain\":\"ethereum-sepolia\",\"chainLabel\":\"Ethereum Sepolia\",\"chainId\":11155111,\"asset\":\"ETH\",\"decimals\":18,\"minimumAmount\":\"0.000001\",\"maximumAmount\":\"0.001\",\"defaultAmount\":\"0.00001\",\"nativeAsset\":\"ETH\",\"walletRpcUrl\":\"https://ethereum-sepolia-rpc.publicnode.com\",\"explorerUrl\":\"https://sepolia.etherscan.io\"},{\"chain\":\"bnb-testnet\",\"chainLabel\":\"BNB Testnet\",\"chainId\":97,\"asset\":\"TBNB\",\"decimals\":18,\"minimumAmount\":\"0.00001\",\"maximumAmount\":\"0.01\",\"defaultAmount\":\"0.001\",\"nativeAsset\":\"TBNB\",\"walletRpcUrl\":\"https://bsc-testnet-dataseed.bnbchain.org\",\"explorerUrl\":\"https://testnet.bscscan.com\"}]",
        "DEMO_EXPIRY_SECONDS": "1800"
      }
    }
  }
}
