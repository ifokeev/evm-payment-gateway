{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evm-payment-gateway-demo",
  "main": "demo/worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./demo/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "secrets": {
    "required": [
      "PAYMENT_API_KEY",
      "PAYMENT_WEBHOOK_SECRET",
      "DEMO_SESSION_SECRET",
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "services": [
    {
      "binding": "GATEWAY",
      "service": "evm-payment-gateway-api"
    }
  ],
  "kv_namespaces": [{ "binding": "DEMO_EVENTS" }],
  "ratelimits": [
    {
      "name": "DEMO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "DEMO_CHAIN": "base-sepolia",
    "DEMO_ASSET": "USDC",
    "DEMO_ASSET_DECIMALS": "6",
    "DEMO_MIN_AMOUNT": "0.01",
    "DEMO_MAX_AMOUNT": "5",
    "DEMO_EXPIRY_SECONDS": "1800"
  }
}
