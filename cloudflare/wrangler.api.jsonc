{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evm-payment-gateway-api",
  "main": "src/api.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "observability": { "enabled": true },
  "secrets": {
    "required": ["PAYMENT_API_KEY", "DEPOSIT_XPUB", "NETWORKS_JSON", "PAYMENT_WEBHOOK_URL", "PAYMENT_WEBHOOK_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evm-payment-gateway",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "SWEEP_QUEUE", "queue": "evm-payment-gateway-sweeps" }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "DEFAULT_EXPIRY_SECONDS": "1800",
    "MAX_EXPIRY_SECONDS": "86400",
    "PAYMENT_GRACE_SECONDS": "60",
    "REORG_HISTORY_BLOCKS": "256",
    "SWEEPER_MAX_GAS_FUNDING_WEI": "10000000000000000",
    "SWEEPER_MIN_TOKEN_PAYMENT_BPS": "5000"
  }
}
