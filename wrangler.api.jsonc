{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evm-payment-gateway-api",
  "main": "src/api.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evm-payment-gateway",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SWEEP_QUEUE", "queue": "evm-payment-gateway-sweeps" }]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "DEFAULT_EXPIRY_SECONDS": "1800",
    "MAX_EXPIRY_SECONDS": "86400",
    "PAYMENT_GRACE_SECONDS": "60",
    "REORG_HISTORY_BLOCKS": "256",
    "SWEEPER_MIN_TOKEN_PAYMENT_BPS": "5000"
  },
  "env": {
    "testnet": {
      "secrets": {
        "required": [
          "PAYMENT_API_KEY",
          "NETWORKS_JSON",
          "PAYMENT_WEBHOOK_URL",
          "PAYMENT_WEBHOOK_SECRET"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "evm-payment-gateway-testnet",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "SWEEP_QUEUE", "queue": "evm-payment-gateway-sweeps-testnet" }]
      },
      "vars": {
        "DEFAULT_EXPIRY_SECONDS": "1800",
        "MAX_EXPIRY_SECONDS": "86400",
        "PAYMENT_GRACE_SECONDS": "60",
        "REORG_HISTORY_BLOCKS": "256",
        "SWEEPER_MIN_TOKEN_PAYMENT_BPS": "5000"
      }
    },
    "mainnet": {
      "secrets": {
        "required": [
          "PAYMENT_API_KEY",
          "NETWORKS_JSON",
          "PAYMENT_WEBHOOK_URL",
          "PAYMENT_WEBHOOK_SECRET"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "evm-payment-gateway-mainnet",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SWEEP_QUEUE",
            "queue": "evm-payment-gateway-sweeps-mainnet"
          }
        ]
      },
      "vars": {
        "DEFAULT_EXPIRY_SECONDS": "1800",
        "MAX_EXPIRY_SECONDS": "86400",
        "PAYMENT_GRACE_SECONDS": "60",
        "REORG_HISTORY_BLOCKS": "256",
        "SWEEPER_MIN_TOKEN_PAYMENT_BPS": "5000"
      }
    }
  }
}
