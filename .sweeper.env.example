GATEWAY_URL=http://gateway:8090
DEPOSIT_XPRV=xprv-from-m-44h-60h-0h-0

# Add a gas wallet key for each enabled network that has configured tokens.
# Native-only networks do not need one. Keep these keys out of .env.
BASE_SEPOLIA_GAS_PRIVATE_KEY=0xprivate-key-for-low-balance-gas-wallet
SWEEPER_POLL_INTERVAL_SECONDS=5
